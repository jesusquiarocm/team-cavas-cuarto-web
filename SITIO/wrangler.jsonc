{
  "name": "team-cavas-cuarto",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "cavascuartoteam.com", "custom_domain": true },
    { "pattern": "www.cavascuartoteam.com", "custom_domain": true }
  ]
}
